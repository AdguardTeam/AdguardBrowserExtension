.git
.idea
.vscode
.DS_Store
.eslintcache
*.tsbuildinfo
# Local ESLint/TypeScript caches; in CI these directories are BuildKit cache
# mounts in the lint stage, so they must not enter the build context.
.cache/
build/
output/
tmp/
vendor/
node_modules/
# Integration-test zips arrive via the `chrome-artifacts` named build context;
# excluding them keeps the default context hash stable across runs.
artifacts/
Dockerfile*
*.md
!README.md
# Read by tests/tools/ci/publish-release-workflow.test.ts.
!DEPLOYMENT.md
# Read by tests/tools/browser-test/firefox-pinned-version.test.ts.
!Dockerfile
*.log
private/
# Never bake live credentials (e.g. TOKENGUARD_API_KEY from .env) into images.
.env
.env.*
