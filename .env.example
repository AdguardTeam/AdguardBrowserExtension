# Artifactory domain is needed for blocking pages download
ARTIFACTORY_DOMAIN=<artifactory_domain>
# TokenGuard API key is needed for checking dangerous script rules
TOKENGUARD_API_KEY=<tokenguard_api_key>
# Optional overrides for the dangerous rules check
# TOKENGUARD_BASE_URL=https://tokenguard.int.agrd.dev/api/v1/
# TOKENGUARD_MODEL=deepseek-v4-flash
