.about {
    padding: 16px 16px 40px 16px;
    font-weight: 400;

    &__title {
        font-weight: 700;
        font-size: 20px;
        margin-bottom: 8px;
    }

    &__version {
        color: var(--text-description-description-default);
        font-size: 14px;
        line-height: 1.3;
    }

    &__current-version {
        margin: 0 0 24px;

        &--with-update {
            margin-bottom: 8px;
        }
    }

    &__update-available {
        margin: 0 0 24px;
        font-size: 14px;
    }

    &__libs {
        list-style: none;
        margin: 0 0 24px;
        padding-left: 0;

        li + li {
            margin-top: 8px;
        }
    }

    &__copyright {
        font-size: 14px;
        line-height: 1.3;
        color: var(--text-description-description-default);
        margin-bottom: 16px;
    }

    &__copyright-reserved {
        display: block;
        margin-top: 8px;
    }

    .links-menu__item {
        margin: 8px 0;
    }

    &__link-icon {
        margin-left: 8px;
    }
}
