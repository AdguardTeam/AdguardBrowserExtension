.warningWrapper {
    padding: 16px;
}

.warning {
    max-width: 600px;
    padding: 24px;
    border-radius: 8px;
    background-color: var(--fills-backgrounds-page-background-additional-default);
    position: relative;
}

.close {
    position: absolute;
    right: 16px;
    top: 16px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
}

.title {
    font-size: 20px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--text-main-text-main-default);
}

.subtitle {
    color: var(--text-main-text-main-default);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    margin-top: 8px;
}

.warningSections {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 18px;
}

.section {
    display: flex;
    gap: 12px;
    line-height: 1.3;
}

.sectionTitle {
    font-size: 14px;
    font-weight: 600;
}

.sectionDescription {
    font-size: 14px;
    font-weight: 400;
    margin-top: 2px;
    color: var(--text-description-description-default);
}

.link {
    cursor: pointer;
    color: var(--text-links-attention-link-default);
    margin-top: 4px;
    text-decoration: none;
    display: block;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    line-height: inherit;

    &:hover {
        text-decoration: none;
    }
}

.getAppSection {
    margin-top: 33px;
    position: relative;
}

.getAppSection::after {
    content: "";
    position: absolute;
    width: 100%;
    height: 1px;
    background-color: var(--stroke-dividers-item-divider-default);
    top: -16px;
}

.getAppButton {
    margin-top: 16px;
}
