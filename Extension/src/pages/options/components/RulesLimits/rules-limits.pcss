.rules-limits {
    font-size: 14px;
    line-height: 18px;
    font-weight: 400;

    &__section {
        padding: 16px;

        &-title {
            font-size: 16px;
            line-height: 21px;
            font-weight: 600;
            margin-bottom: 4px;
        }
    }

    &__group {
        &-limits {
            font-weight: 600;
        }
    }

    &__text {
        &--gray {
            color: var(--text-description-description-default);
        }

        &--orange {
            color: var(--text-links-attention-link-default);
        }

        &--green {
            color: var(--text-links-link-default);
        }
    }
}
