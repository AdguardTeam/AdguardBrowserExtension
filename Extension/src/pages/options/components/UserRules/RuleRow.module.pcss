.row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 40px;
    padding: 8px 16px;
    border-radius: 8px;
    transition: background-color 0.1s ease;
}

@media (hover: hover) {
    .row:hover {
        background-color: var(--fills-backgrounds-page-background-hovered);
    }

    .row:hover .actions {
        opacity: 1;
    }
}

.row:focus-within {
    background-color: var(--fills-backgrounds-page-background-hovered);
}

.row:focus-within .actions {
    opacity: 1;
}

.actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    flex-shrink: 0;
    align-self: flex-start;
    opacity: 0;
    transition: opacity 0.1s ease;
}

/* Touch devices have no hover: keep the actions permanently visible. */
@media (hover: none) {
    .actions {
        opacity: 1;
    }
}

.actionButton {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
}

.actionButton:disabled {
    cursor: default;
    opacity: 0.5;
}

.actionButton:focus-visible {
    outline: 2px solid var(--outline);
    border-radius: 4px;
}

.actionIcon {
    width: 24px;
    height: 24px;
}

.comment {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding-left: 32px;
    color: var(--editor-comment);
}

.commentText {
    display: flex;
    flex-direction: column;
    font-size: 14px;
    line-height: 20px;
}

.commentLine {
    white-space: pre-wrap;
    word-break: break-word;
}

/* Large comment blocks are rendered through a nested window virtualizer
   (CommentBlockLines): the viewport reserves the block's full height inline
   and positions the rendered lines absolutely, so only the lines
   intersecting the document viewport are mounted while the block stays one
   row of the outer list virtualizer. */
.commentLinesViewport {
    position: relative;
    width: 100%;
}

.commentLineVirtualized {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
}

/* Take the free space left by the actions and allow the text to shrink. */
.rule,
.ruleText,
.commentEditing,
.commentVirtualized,
.commentTextEditing,
.commentTextVirtualized {
    flex: 1;
    min-width: 0;
}

.rule {
    display: flex;
    align-items: flex-start;
    gap: 12px;
}

.ruleText {
    font-size: 14px;
    line-height: 20px;
    /* Rule rows are single-line per the mockup; the full text is available in
       the inline editor, which scrolls horizontally. Comment blocks keep
       wrapping so every line stays visible. */
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/*
 * The mockup puts the checkbox, the icon and the text on the middle of the
 * row. A 20px text line at the top of the row's content has its baseline 1px
 * higher than the mockup, so the text (and the editor that replaces it) is
 * moved down by `TEXT_OFFSET_TOP_PX`. The negative bottom margin keeps the
 * height of the row unchanged.
 */
.ruleText,
.commentText,
.rule > :global(.editor--inline) {
    margin-top: 1px;
    margin-bottom: -1px;
}

.icon {
    width: 24px;
    height: 24px;
    align-self: flex-start;
}

.checkbox {
    appearance: none;
    -webkit-appearance: none;
    position: relative;
    flex-shrink: 0;
    align-self: flex-start;
    width: 20px;
    height: 20px;
    /* Centres the 20px checkbox on the 24px icon next to it. */
    margin: 2px 0;
    border: 1.5px solid var(--stroke-icons-product-icon-default);
    border-radius: 0;
    cursor: pointer;
}

.checkbox:checked {
    background-color: var(--stroke-icons-product-icon-default);
    border-color: var(--stroke-icons-product-icon-default);
}

.checkbox:checked::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 5px;
    height: 10px;
    border: solid var(--gray-0);
    border-width: 0 2px 2px 0;
    transform: translate(-55%, -60%) rotate(45deg);
}

.checkbox:focus-visible {
    outline: 2px solid var(--outline);
}

.highlight {
    background-color: var(--fills-backgrounds-highlight-attention-default);
}

.disabledRule {
    color: var(--text-user-rules-gray-default);
}

.disabledRule .ruleText {
    opacity: 0.5;
}

/* Actions stay visible while the row is being edited, even if the editor
   temporarily loses focus. */
.rowEditing .actions {
    opacity: 1;
}

/* User rules are turned off: every action stays available, only the look
   changes. The rule and comment text is dimmed and the checkbox turns gray.
   In a comment row the inline editor is rendered inside `.commentText`, so the
   text is dimmed only while the comment is not being edited. */
.rowFilterOff .ruleText,
.rowFilterOff .commentText:not(.commentTextEditing) {
    opacity: 0.5;
}

.rowFilterOff .checkbox {
    border-color: var(--text-user-rules-gray-default);
}

/* The checked fill is a fixed mid gray instead of the dimmed text color: the
   white tick keeps a 4:1 contrast in both themes, while the lighter gray of
   the dark theme would leave it at about 1.8:1. */
.rowFilterOff .checkbox:checked {
    border-color: var(--gray-60);
    background-color: var(--gray-60);
}
