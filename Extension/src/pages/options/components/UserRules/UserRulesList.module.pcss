.container {
    --editor-comment: var(--text-user-rules-gray-default);
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    padding: 0 16px;
}

.toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 0 16px;
}

.searchWrapper {
    position: relative;
    flex: 1;
    margin-top: 16px;
}

.search {
    width: 100%;
    height: 48px;
    padding: 0 48px 0 16px;
    border: 1px solid var(--stroke-inputs-inactive-input-stroke-default, #A4A4A4);
    border-radius: 8px;
    background: var(--fills-backgrounds-page-background-additional-default);
    color: var(--text-main-text-main-default);
    font-size: 14px;
    line-height: 20px;
}

.search::placeholder {
    color: var(--text-placeholder-placeholder-default);
}

.search:focus-visible {
    border-color: var(--stroke-inputs-active-input-stroke-default);
    outline: none;
}

.clearButton {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: var(--stroke-icons-product-icon-default);
    cursor: pointer;
    transition: var(--t3) background-color;
}

.clearButton:hover {
    @media (hover: hover) {
        background-color: var(--fills-backgrounds-page-background-hovered);
    }
}

.clearIcon {
    width: 24px;
    height: 24px;
}

.createRule {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--stroke-icons-product-icon-default);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    cursor: pointer;
    transition: var(--t3) background-color;
}

.createRule:hover {
    @media (hover: hover) {
        background-color: var(--fills-backgrounds-page-background-hovered);
    }
}

.createRuleIcon {
    width: 24px;
    height: 24px;
}

.deletedRuleWrapper {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    max-width: 100%;
}

.deletedRuleText {
    display: block;
    font-weight: 700;
    word-break: break-word;
}

.listArea {
    position: relative;
}

.virtualList {
    width: 100%;
    position: relative;
}

.virtualRow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
}

.placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 48px 16px;
    color: var(--text-description-description-default);
    font-size: 14px;
    line-height: 20px;
}

.disabled {
    opacity: 0.5;
    pointer-events: none;
}

.highlightLoading {
    padding: 4px 16px;
    font-size: 12px;
    color: var(--editor-comment);
}
