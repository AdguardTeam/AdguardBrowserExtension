.request-preview {
    flex-grow: 1;
    display: flex;
    flex-direction: column;

    &__status {
        height: 100%;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    &__text {
        font-size: 16px;
    }
}
