.request-modal {
    &__title {
        &_fixed {
            z-index: var(--z-idx-filtering-log-base);
        }
    }

    &__controls {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 24px 16px;

        &_fixed {
            z-index: var(--z-idx-filtering-log-base);
        }
    }

    &__button {
        width: 100%;
        max-width: 100%;
        padding: 12px 16px;
    }

    &__url-button {
        display: inline-block;
        margin-top: 8px;
        margin-right: 16px;
        font-size: 14px;
        line-height: 18px;
    }

    &__text-actions {
        display: flex;
    }

    &__dragbar {
        position: absolute;
        top: 0;
        left: 0;
        width: 8px;
        height: 100%;
        box-sizing: border-box;
        cursor: col-resize;
    }

    &__text {
        padding: 8px;
        margin: 0 16px;
        border: 1px solid var(--stroke-inputs-active-input-stroke-default);
        border-radius: 4px;
        flex: 1;
        min-height: 0;
        overflow-y: scroll;

        @media (--to-mobile) {
            padding: 16px;
        }

        pre {
            margin: 0;
        }

        code {
            word-break: break-all;
            white-space: break-spaces;
        }
    }
}
